# rent_car — nightly backup timer. Copy to
# /etc/systemd/system/rent-car-backup.timer (see the .service for install steps).

[Unit]
Description=Run rent_car backup nightly

[Timer]
# 02:00 daily, Asia/Bangkok (pinned below, not host-local). Persistent=true runs a missed backup on next
# boot (e.g. if the box was off overnight).
# Timezone pinned explicitly: OnCalendar resolves against the HOST zone,
# which is UTC by default and would shift this by 7 hours.
OnCalendar=*-*-* 02:00:00 Asia/Bangkok
Persistent=true

[Install]
WantedBy=timers.target
