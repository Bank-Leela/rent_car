# rent_car — timer that runs the daily จัดรอบ each evening (assigns TOMORROW).
# Copy to /etc/systemd/system/rent-car-batch.timer, then enable the timer
# (see rent-car-batch.service.sample for the full install commands).

[Unit]
Description=Run rent_car daily batch (จัดรอบ) every evening

[Timer]
# 20:00 daily, Asia/Bangkok (pinned below, not host-local). The app must run TZ=Asia/Bangkok (see the
# main service unit + docs/deployment.md) so "tomorrow" is the right day.
# Timezone pinned explicitly: OnCalendar resolves against the HOST zone,
# which is UTC by default and would shift this by 7 hours.
OnCalendar=*-*-* 20:00:00 Asia/Bangkok
Persistent=true

[Install]
WantedBy=timers.target
