# rent_car — nginx reverse proxy (Linux server)
# Copy to /etc/nginx/sites-available/rent_car, symlink into sites-enabled,
# edit server_name + the TLS cert paths, then: nginx -t && systemctl reload nginx
#
# The Next.js app runs on 127.0.0.1:3000 (see deploy/rent-car.service.sample).

server {
    listen 80;
    server_name booking.example.ac.th;   # <-- your host

    # Redirect all HTTP to HTTPS.
    # Let Let's Encrypt's HTTP-01 check through BEFORE the redirect, or a webroot
    # renewal is bounced to https and fails. Harmless when unused.
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    # nginx >= 1.25.1 warns about "http2" here and wants a separate `http2 on;`
    # line instead. Both forms work today; if `nginx -t` warns, split them.
    listen 443 ssl http2;
    # TLS policy falls back to your distro's defaults. If certbot installed its
    # recommended profile, prefer it:
    #   include /etc/letsencrypt/options-ssl-nginx.conf;
    #   ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    server_name booking.example.ac.th;    # <-- your host

    ssl_certificate     /etc/letsencrypt/live/booking.example.ac.th/fullchain.pem;   # <-- your cert
    ssl_certificate_key /etc/letsencrypt/live/booking.example.ac.th/privkey.pem;     # <-- your key

    # File uploads: booking attachments / outsource quotes / signed PDFs are
    # capped at 10 MB in-app — allow a little headroom so nginx doesn't 413 first.
    client_max_body_size 12m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }

    # Long-cache Next.js build assets (immutable, content-hashed).
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
