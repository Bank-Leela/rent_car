# rent_car — systemd unit (Linux server)
# Copy to /etc/systemd/system/rent-car.service, edit paths + User, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now rent-car
# Logs: journalctl -u rent-car -f   (the TZ warning from instrumentation.ts shows here)

[Unit]
Description=rent_car vehicle booking (Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=rentcar
WorkingDirectory=/opt/rent_car

# CRITICAL: scheduling (จัดรอบ / trip-legs) computes day boundaries in
# server-local time. Without this the batch assigns the wrong day.
Environment=TZ=Asia/Bangkok
Environment=NODE_ENV=production

# Secrets + config live here (chmod 600, owned by the service user). Include:
#   DATABASE_URL, AUTH_SECRET, NEXTAUTH_URL (or APP_URL), UPLOADS_DIR,
#   and any optional GOOGLE_MAPS_API_KEY / CRON_SECRET keys.
EnvironmentFile=/etc/rent_car.env

# `npm run build` already runs `prisma migrate deploy`; `npm run start` = next start.
#
# `-H 127.0.0.1` binds the app to loopback so it is reachable ONLY through nginx.
# Without it, `next start` binds 0.0.0.0:3000 and port 3000 is exposed on every
# interface, bypassing TLS. NOTE: this Next version does NOT read a HOSTNAME env
# var for `start` (only PORT) — the -H flag is the only way to set the bind host
# (verified in the next-start CLI).
#
# npm path: this assumes npm at /usr/bin/npm (nodesource/apt). With nvm or another
# Node install that path won't exist and the unit fails to start — run
# `which npm` and use its absolute path here.
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
