// Vehicle Booking System schema.
// See claude_code_implementation_plan.md section 4 for entity descriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  REQUESTER
  APPROVER
  ADMIN
  DRIVER
}

enum VehicleType {
  SEDAN
  PICKUP
  VAN
  OTHER
}

// Requester's preferred vehicle CATEGORY at booking time — distinct from
// VehicleType (the owned fleet's physical classification). Informational
// only; does not drive assignment. Bus is always outsourced (not in the
// owned fleet); the dean's sedan is a specific, named vehicle.
enum PreferredVehicleType {
  VAN
  TRUCK_6_WHEEL
  PICKUP
  SEDAN_DEAN
  BUS_OUTSOURCED
}

enum DriverPool {
  PUBLIC
  PRIVATE
}

enum BookingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ASSIGNED
  DENIED
  CANCELLED
  COMPLETED
  // Submit-time overflow: the day's morning/afternoon slots (active non-duty
  // vehicles) were full, so this request is queued rather than guaranteed.
  WAITLIST
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum EvaluationRating {
  NOT_GOOD
  SLIGHTLY_NOT_GOOD
  GOOD
  VERY_GOOD
}

// CR-02: driver-side scheduling lifecycle. The admin only allows the booking
// + picks a vehicle; drivers then claim primary/secondary roles, and the
// primary driver confirms the trip is dispatch-ready.
enum DriverScheduleStatus {
  UNCLAIMED
  CLAIMED
  CONFIRMED
}

enum ClaimRole {
  PRIMARY
  SECONDARY
}

enum ClaimStatus {
  ACTIVE
  RELEASED
}

// CR-07: job categories for the daily batch solver. Names reflect the
// supervisor's matrix exactly.
//   TJW    = ต่างจังหวัด — out-of-province AND overnight (weight 4)
//   OT     = overtime — overnight same-area OR start<08:00 OR end>16:00 (3)
//   WERN   = รถเวร — duty driver doing standing campus rounds
//   NORMAL = ทั่วไป — short on-campus runs inside 08:00–16:00 (weight 2)
// SMUS stays reachable via the column type in case the client later
// emits it; the classifier never auto-assigns SMUS today.
enum JobType {
  TJW
  OT
  WERN
  NORMAL
  SMUS
}

// CR-07: reason a booking didn't land in the daily batch and was
// surfaced to Khun Top. NEEDS_WERN_RECLAIM_DECISION is the special
// >400 km + thin-staff conflict described in Update 9 of the change
// log: ops must explicitly choose to reclaim the duty driver or keep
// duty and outsource the trip.
enum OverflowReason {
  NO_SLOT
  NO_PRIMARY_DRIVER
  NO_SECONDARY_DRIVER
  NEEDS_WERN_RECLAIM_DECISION
}

// CR-05: four fixed time buckets used by Algorithm 1 (slot allocation).
// Derived from Booking.startAt at create time and persisted so the slot
// grid stays cheap to read.
enum TimeBucket {
  BEFORE_08
  MORNING_08_12
  AFTERNOON_12_16
  AFTER_16
}

// ---------- NextAuth core tables ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain entities ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  // CR-08: login identifier separate from email. Users can change either
  // their username or password on /account; email stays put because it's
  // the recovery path for forgotten credentials.
  //
  // CR-08 follow-up: username can be changed at most once by the user.
  // `usernameChangedAt` is null until the user takes their one change;
  // after that the input is locked and only an admin can change it via
  // /admin/users. Password rotations have no such limit.
  username           String?   @unique
  usernameChangedAt  DateTime?
  name          String?
  thaiName      String?
  image         String?
  phone         String?
  lineUserId    String?   @unique

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])

  signatureImageUrl String?

  delegatedToUserId String?
  delegatedTo       User?   @relation("Delegation", fields: [delegatedToUserId], references: [id])
  delegatedBy       User[]  @relation("Delegation")

  // CR-07: admin-managed credentials. Replaces Google OAuth. Users without
  // a passwordHash can't sign in via the credentials form. mustChangePassword
  // forces a reset on next login (used when admin sets/resets a password).
  passwordHash         String?
  mustChangePassword   Boolean  @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles               UserRole[]
  accounts            Account[]
  sessions            Session[]
  driverProfile       Driver?
  headedDepartment    Department?    @relation("DepartmentHead")
  representedDepartment Department?  @relation("DepartmentRepresentative")
  bookings            Booking[]      @relation("BookingRequester")
  approvals           Approval[]
  cancellations       Cancellation[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  tripTemplates       TripTemplate[]
}

// CR-07: hook table for future self-service password reset email flow.
// Not yet wired into a UI; admin reset is the only path right now.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Department {
  id                   String  @id @default(cuid())
  nameEn               String
  nameTh               String
  headUserId           String? @unique
  head                 User?   @relation("DepartmentHead", fields: [headUserId], references: [id])
  representativeUserId String? @unique
  representative       User?   @relation("DepartmentRepresentative", fields: [representativeUserId], references: [id])

  members  User[]    @relation("DepartmentMembers")
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id                 String      @id @default(cuid())
  registrationNumber String      @unique
  type               VehicleType
  capacity           Int
  // CR-05: marks the reserve fleet (คันเวร). These vehicles appear as a
  // dedicated row in the slot grid and are reserved for on-call work.
  isDutyVehicle      Boolean     @default(false)
  notes              String?
  isActive           Boolean     @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id               String     @id @default(cuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool             DriverPool
  licenseNumber    String?
  licenseExpiresAt DateTime?
  isActive         Boolean    @default(true)
  // CR-05: fairness tie-break. Bumped to the trip's startAt whenever the
  // matcher assigns this driver a primary or secondary role.
  lastAssignedAt   DateTime?
  // CR-07: per-category rotation timestamps. Bumped provisionally on
  // assignment and finalised on completion (Update 10 of the change log).
  // Rolled back on cancellation so the driver keeps their rotation slot.
  lastTjwAt        DateTime?
  lastOtAt         DateTime?
  lastDutyAt       DateTime?

  primaryBookings   Booking[] @relation("PrimaryDriver")
  secondaryBookings Booking[] @relation("SecondaryDriver")
  claims            BookingClaim[]
  onCallShifts      OnCallShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id        String @id @default(cuid())
  jobNumber String @unique

  requesterId  String
  requester    User       @relation("BookingRequester", fields: [requesterId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  purpose          String
  destination      String
  province         String
  startAt          DateTime
  endAt            DateTime
  passengerCount   Int
  // Optional male/female passenger breakdown (need not sum to passengerCount).
  maleCount        Int?
  femaleCount      Int?
  passengerNotes   String?
  // The ajarn (professor) being transported. Captured at submission time so
  // the work owner and driver can coordinate without phoning the requester.
  ajarnName        String   @default("")
  ajarnPhone       String   @default("")
  ajarnEmail       String   @default("")
  // Coordinator (ผู้ประสานงาน): the contact person arranging the trip,
  // distinct from the requester whose name rides on the booking.
  coordinatorName  String   @default("")
  coordinatorPhone String   @default("")
  // Required justification when start/end falls outside driver work hours
  // (07:00–18:00) or spans midnight. Set on submission or time edit.
  outOfHoursReason String?
  needsOutsourcing Boolean  @default(false)
  // Requester-flagged emergency/urgent trip + optional free-text reason.
  isEmergency      Boolean  @default(false)
  emergencyReason  String?
  // Where passengers board ("place to get on the car").
  pickupLocation   String?
  // Whether the vehicle/driver waits at the destination for the whole visit.
  // Independent of pickupReturnTime — neither field gates the other.
  waitAtDestination Boolean @default(true)
  // If the vehicle doesn't wait, what time it comes back to collect
  // passengers ("HH:mm", same calendar day as the trip).
  pickupReturnTime  String?
  // Requester's preferred vehicle category. Required; informational only —
  // does not drive assignment.
  preferredVehicleType PreferredVehicleType @default(VAN)
  // Admin-set flag: this trip should get a secondary driver. Replaces the
  // old estimatedDistance > 400km auto-check now that distance is no longer
  // collected from the requester; the use case is overnight out-of-province
  // trips, decided case-by-case by the staff member assigning the vehicle.
  needsSecondaryDriver Boolean @default(false)

  status       BookingStatus @default(DRAFT)
  denialReason String?

  vehicleId         String?
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id])
  primaryDriverId   String?
  primaryDriver     Driver?  @relation("PrimaryDriver", fields: [primaryDriverId], references: [id])
  secondaryDriverId String?
  secondaryDriver   Driver?  @relation("SecondaryDriver", fields: [secondaryDriverId], references: [id])

  estimatedDistance Int?

  recurrenceParentId String?
  recurrenceParent   Booking?        @relation("BookingRecurrence", fields: [recurrenceParentId], references: [id])
  recurrenceChildren Booking[]       @relation("BookingRecurrence")
  recurrenceRule     RecurrenceRule?

  // CR-02: independent of overall booking status, this tracks the driver
  // self-scheduling lifecycle. Set to UNCLAIMED on creation; flipped when
  // drivers claim and the primary confirms.
  driverScheduleStatus DriverScheduleStatus @default(UNCLAIMED)

  // CR-05: job category set by the requester at submission. Drives
  // Algorithm 2 (driver capacity). Required for new bookings; legacy rows
  // are backfilled to OT.
  jobType    JobType
  // CR-05: derived from startAt at create. Persisted so the slot grid
  // doesn't recompute on every read.
  timeBucket TimeBucket
  // CR-06: matcher escalation. Set true when the auto-match fails (no
  // slot / no driver) and ops decides to send the case to Khun Top
  // (manual handling, possible outsourcing).
  escalatedToKhunTop Boolean @default(false)
  // CR-07: explicit out-of-province flag. The classifier needs this to
  // distinguish TJW (out-of-province + overnight) from local overnight =
  // OT. Backfilled from province != Bangkok for legacy rows.
  outOfProvince     Boolean         @default(false)
  // Trip stays entirely within the Chula campus. When true, the requester
  // is asking for the duty (รถเวร) vehicle rather than a normal dispatch —
  // createBookingAction forces jobType=WERN, bypassing classifyJobType.
  // Inverted from the old `outsideChula` (replaces the province dropdown's
  // campus/off-campus signal).
  travelWithinChula Boolean         @default(false)
  // CR-07: why the booking didn't land in the daily batch (if at all).
  // Cleared once a successful match is recorded; NEEDS_WERN_RECLAIM_DECISION
  // requires Khun Top to choose between reclaiming duty or outsourcing.
  overflowReason    OverflowReason?

  outsourceVendor    String?
  outsourceCost      Decimal? @db.Decimal(10, 2)
  outsourceReference String?

  pdfUrl String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  decidedAt   DateTime?
  completedAt DateTime?

  approvals     Approval[]
  trip          Trip?
  cancellations Cancellation[]
  auditLogs     AuditLog[]
  claims        BookingClaim[]

  @@index([status, createdAt])
  @@index([startAt])
}

// A requester's saved trip preset. Stores everything a booking needs EXCEPT
// the dates (startAt/endAt) and recurrence, so a recurring trip can be
// re-filled in one click and only the date has to change. Owned by the user;
// deleted with them (onDelete: Cascade).
model TripTemplate {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot of the booking form (mirrors Booking, minus dates/recurrence).
  purpose            String
  destination        String
  province           String
  pickupLocation     String?
  waitAtDestination  Boolean @default(true)
  pickupReturnTime   String?
  passengerCount     Int     @default(1)
  maleCount          Int?
  femaleCount        Int?
  passengerNotes     String?
  ajarnName          String  @default("")
  ajarnPhone         String  @default("")
  ajarnEmail         String  @default("")
  coordinatorName    String  @default("")
  coordinatorPhone   String  @default("")
  preferredVehicleType PreferredVehicleType @default(VAN)
  outOfProvince      Boolean @default(false)
  travelWithinChula  Boolean @default(false)
  needsOutsourcing   Boolean @default(false)
  isEmergency        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One driver is on-call (รถเวร) per calendar day. The auto-assign algorithm
// rotates through the pool round-robin and skips the on-call driver from
// regular jobs that day.
model OnCallShift {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CR-02: drivers self-claim trips. There's at most one ACTIVE claim per
// (booking, role); released claims are kept for audit. Setting primary +
// secondary on Booking is denormalized from the active claims.
model BookingClaim {
  id         String      @id @default(cuid())
  bookingId  String
  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver      @relation(fields: [driverId], references: [id])
  role       ClaimRole
  status     ClaimStatus @default(ACTIVE)
  claimedAt  DateTime    @default(now())
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId, status])
  @@index([driverId, status])
}

model RecurrenceRule {
  id              String   @id @default(cuid())
  parentBookingId String   @unique
  parentBooking   Booking  @relation(fields: [parentBookingId], references: [id], onDelete: Cascade)
  rrule           String
  startDate       DateTime
  endDate         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Approval {
  id                String         @id @default(cuid())
  bookingId         String
  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  approverId        String
  approver          User           @relation(fields: [approverId], references: [id])
  status            ApprovalStatus @default(PENDING)
  signatureImageUrl String?
  comment           String?
  decidedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trip {
  id             String    @id @default(cuid())
  bookingId      String    @unique
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startMileage   Int
  endMileage     Int?
  distanceKm     Int?
  fuelCost       Decimal?  @db.Decimal(10, 2)
  tollwayCost    Decimal?  @db.Decimal(10, 2)
  usedExpressway Boolean   @default(false)
  driverNotes    String?
  startedAt      DateTime
  endedAt        DateTime?

  evaluation Evaluation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cancellation {
  id                String   @id @default(cuid())
  bookingId         String
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cancelledByUserId String
  cancelledByUser   User     @relation(fields: [cancelledByUserId], references: [id])
  reason            String
  cancelledAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Evaluation {
  id          String           @id @default(cuid())
  tripId      String           @unique
  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rating      EvaluationRating
  comment     String?
  submittedAt DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String         @id @default(cuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User           @relation(fields: [actorUserId], references: [id])
  fromStatus  BookingStatus?
  toStatus    BookingStatus?
  action      String
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
}
