# ─────────────────────────────────────────────────────────────────────────────
# rent_car — environment template.  Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# NAMES ONLY — never commit real values.  `.gitignore` blocks `.env` itself.
# A repo-root `.env` is picked up automatically by Next.js AND by Prisma (the
# generated client bakes the path in), so `npm run dev`, `npx prisma …`,
# `npm test` and the seed all read it.  Nothing needs exporting.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# The database.  The only variable prisma/schema.prisma reads.
# Matches docker-compose.yml out of the box.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rent_car?schema=public

# Signs the login session.  REQUIRED IN DEVELOPMENT TOO.
# Generate with:  openssl rand -base64 32
#
# No file in this repo reads this name — Auth.js consumes it internally — so
# grepping the project for it finds nothing and it looks optional.  It is not:
# without it NOBODY CAN SIGN IN, and the login page reports
# "อีเมล/ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง" (wrong username or password) even when
# the password is correct.  The real cause appears only in the server log.
AUTH_SECRET=

# Scheduling is timezone-critical.  In production the app REFUSES TO BOOT on the
# wrong zone ([TZ FATAL]); in development it only warns, and then quietly
# schedules against the wrong clock — which is worse.
TZ=Asia/Bangkok


# ── OPTIONAL — each one gates a dormant feature; unset is a safe default ─────

# Public base URL.  Unset: notification emails lose their "view booking" button
# and password-reset links are generated as http://localhost:3000/...
# APP_URL=https://booking.example.ac.th

# Outbound email.  Set BOTH or NEITHER.
# Unset, mail is not delivered and the log records only that it was suppressed —
# password-reset links are LOST, not printed.  Recover with scripts/reset-password.ts.
# RESEND_API_KEY=
# EMAIL_FROM=Vehicle Booking <noreply@example.ac.th>

# Authorises the nightly จัดรอบ timer against /api/cron/run-batch.
# Unset, that route answers 503 and the timer fails every night.
# After changing it you MUST restart the app — a running process cannot see it.
# CRON_SECRET=

# Distance estimates for the >400 km co-driver rule.  Unset, distances stay null
# and the manual "needs a co-driver" checkbox is the only trigger.
# GOOGLE_MAPS_API_KEY=

# Inbound LINE webhook.  Unset, that route answers 503.
# (LINE_CHANNEL_ACCESS_TOKEN is currently dead config — nothing sends LINE messages.)
# LINE_CHANNEL_SECRET=

# Where signatures and attachments are written.  Defaults to ./uploads locally.
# PDFs are NOT stored — they are rendered on demand.
# UPLOADS_DIR=/var/lib/rent_car/uploads

# Which account(s) act as the shared driver kiosk, as a comma-separated list of
# emails. Unset, it is the seeded driverstation@chula.ac.th. The kiosk sees every
# car's schedule, so keep this list tight.
# DRIVER_STATION_EMAILS=driverstation@chula.ac.th

# Turns on /admin/simulate.  Leave unset in production.
# ENABLE_SIMULATION=
