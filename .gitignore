# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
uploads/
# Added by code-review-graph
.code-review-graph/

# Claude Code local settings (per-machine perms, never share)
.claude/settings.local.json

# Python bytecode from scripts/devtools
__pycache__/

# Scratch space for probe scripts and screenshots — not build output, not source
scripts/tmp/
