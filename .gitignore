# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the TEMPLATE must ship, or a fresh clone has nothing to copy and the
# setup instructions cannot be followed. It holds names only, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
uploads/
# Added by code-review-graph
.code-review-graph/

# Claude Code local settings (per-machine perms, never share)
.claude/settings.local.json

# Python bytecode from scripts/devtools
__pycache__/

# Scratch space for probe scripts and screenshots — not build output, not source
scripts/tmp/

# Third-party skills installed via `npx skills add`. Vendored copies of other
# people's markdown — not this project's source, and this repo is public.
.agents/

# Symlinks created by `npx skills add`, pointing into the ignored .agents/.
# The real project skills in .claude/skills/ (debug-issue, explore-codebase,
# refactor-safely, review-changes) stay tracked. Listed explicitly rather than
# globbed, so a future hand-written project skill is never silently ignored.
# Provenance lives in skills-lock.json, which IS tracked — restore with
# `npx skills install`.
.claude/skills/brandkit
.claude/skills/design-taste-frontend
.claude/skills/design-taste-frontend-v1
.claude/skills/dev
.claude/skills/full-output-enforcement
.claude/skills/gpt-taste
.claude/skills/high-end-visual-design
.claude/skills/image-to-code
.claude/skills/imagegen-frontend-mobile
.claude/skills/imagegen-frontend-web
.claude/skills/industrial-brutalist-ui
.claude/skills/minimalist-ui
.claude/skills/playwright-cli
.claude/skills/redesign-existing-projects
.claude/skills/stitch-design-taste
.claude/skills/web-design-guidelines
